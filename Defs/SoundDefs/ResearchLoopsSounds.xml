<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ResearchLoops custom sounds, ported from Stellaris stings.
       Audio files live in Sounds/ (ogg, Vorbis); each SoundDef's AudioGrain_Clip.clipPath
       points at the file by name (no extension). Played on the camera as UI notifications. -->

  <!-- 科技开始研究: Stellaris research_click_01 (sound/ui/start_research_01.wav) -->
  <SoundDef>
    <defName>RL_ResearchStart</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <onCamera>true</onCamera>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>RL_ResearchStart</clipPath>
          </li>
        </grains>
        <volumeRange>35~40</volumeRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- 研究完成: Stellaris ui_research_done -> test_rev_up (sound/placeholders/car_start_01.wav) -->
  <SoundDef>
    <defName>RL_ResearchComplete</defName>
